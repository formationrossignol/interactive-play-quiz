# Supabase (required) — same project as apps/app, server-only (no NEXT_PUBLIC_
# prefix: these pages fetch content in Server Components only).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only; required by /api/contact. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Same project again, client-exposed — used by client components that need
# to check auth state or call an edge function (e.g. the /pricing Pro CTA).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: override the app deployment the fallback rewrite proxies to.
# APP_ORIGIN=https://app.brivia.app
# NEXT_PUBLIC_APP_ORIGIN=https://app.brivia.app

# Optional: this marketing site's own canonical domain — used for
# metadataBase/OpenGraph/sitemap.xml/robots.txt. Defaults to https://brivia.app.
# NEXT_PUBLIC_SITE_URL=https://brivia.app

# Public contact identities.
NEXT_PUBLIC_CONTACT_EMAIL=contact@brivia.app
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@brivia.app

# Required before publishing the legal pages. Use the registered entity
# details; never ship invented values.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_FORM=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_REGISTRATION=
LEGAL_PUBLICATION_DIRECTOR=

# Optional: notified after a lead is persisted successfully.
CONTACT_WEBHOOK_URL=

# Optional: error tracking (Sentry). No-op when unset.
NEXT_PUBLIC_SENTRY_DSN=
