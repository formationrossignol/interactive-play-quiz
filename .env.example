# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: AI course generator (CourseGeneratorModal)
# WARNING: this is inlined into the public JS bundle by Vite at build time.
# Do NOT set this in a production deployment — anyone visiting the site could
# extract it from the bundle. Leave unset; users can paste their own key at
# runtime instead (stored in sessionStorage only, never sent to your server).
VITE_ANTHROPIC_API_KEY=

# Optional: error tracking (Sentry) and product analytics (PostHog). Both are
# no-ops when unset — safe to leave blank in local dev.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Transactional email (send-welcome-email Edge Function) is NOT configured
# here — it's a Supabase secret, not a Vite env var:
#   supabase secrets set RESEND_API_KEY=... RESEND_FROM_EMAIL="Brivia <onboarding@yourdomain.com>"
# Requires a Resend account with a verified sending domain. No-ops (skips
# sending) when RESEND_API_KEY isn't set.
